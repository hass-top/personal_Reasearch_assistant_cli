# --- Search settings ---
# duckduckgo (no key) or tavily (needs TAVILY_API_KEY)
SEARCH_PROVIDER=duckduckgo
# How many web sources to feed the model
MAX_SOURCES=5
# Let the model plan several search queries before searching (on/off)
PLANNER=on
# How many extra queries the planner may generate
MAX_QUERIES=3
# --- Question classification (Phase 1) ---
# Label each question with a subject (english/cybersecurity/general) and an
# intent (learn/practice/verify/research). on = one extra LLM call
CLASSIFY=on
# --- Source quality ranking ---
# Score every source: government > university/paper > education > wikipedia > forums
SOURCE_RANKING=on
# Drop sources scoring below this (0 keeps all, 60 keeps education and better)
MIN_SOURCE_SCORE=0